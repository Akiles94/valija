{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Both "node" and "vite/client": `shared/**` (also included below) has
    // files used by main as well as the renderer — translate.ts's
    // `typeof process !== "undefined"` guard needs the ambient `process`
    // type to typecheck at all, even though the renderer never actually
    // gets a working `process` at runtime (sandboxed, nodeIntegration
    // false). This is a type-only availability, not a capability grant.
    "types": ["vite/client", "node"]
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts"]
}
